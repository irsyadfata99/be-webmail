# --- App ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# --- Database (QNAP, database dev) ---
DATABASE_URL="postgresql://mailweb_dev:GANTI_PASSWORD_DEV@18.18.18.121:5432/mailweb_dev"

# --- Admin ---
# Daftar email admin, pisahkan dengan koma. Huruf besar-kecil tidak dibedakan.
ADMIN_EMAILS=admin@example.com
MAIL_DOMAIN=motioneggstudios.com

# --- Mail server (docker-mailserver di QNAP) ---
# Hostname harus sama dengan sertifikat TLS (arahkan lewat file hosts laptop ke IP LAN QNAP)
IMAP_HOST=mail.motioneggstudios.com
IMAP_PORT=993
IMAP_SECURE=true
SMTP_HOST=mail.motioneggstudios.com
SMTP_PORT=465
SMTP_SECURE=true

# --- Keamanan ---
# Generate masing-masing dengan perintah di bawah, jangan dipakai ulang
SESSION_SECRET=GANTI_DENGAN_HEX_64_KARAKTER
CREDENTIAL_ENCRYPTION_KEY=GANTI_DENGAN_HEX_64_KARAKTER
SESSION_TTL_HOURS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# --- Web ---
CORS_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
COOKIE_DOMAIN=
TRUST_PROXY=
# --- Lampiran ---
# Samakan dengan batas pesan Postfix (bawaan sekitar 10 MB)
MAX_ATTACHMENT_MB=10