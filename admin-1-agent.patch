--- /dev/null
+++ b/agent/src/config.ts
@@ -0,0 +1,36 @@
+export interface AgentConfig {
+  token: string;
+  domain: string;
+  configDir: string;
+  port: number;
+  host: string;
+}
+
+/** Membaca dan memvalidasi konfigurasi. Pesan galat hanya menyebut nama variabel, tidak nilainya. */
+export function loadConfig(env: NodeJS.ProcessEnv = process.env): AgentConfig {
+  const problems: string[] = [];
+
+  const token = env.AGENT_TOKEN ?? "";
+  if (!/^[0-9a-f]{64}$/i.test(token)) {
+    problems.push("AGENT_TOKEN: harus 64 karakter hex (32 byte)");
+  }
+
+  const domain = (env.MAIL_DOMAIN ?? "").trim().toLowerCase();
+  if (!/^[a-z0-9-]+(\.[a-z0-9-]+)+$/.test(domain)) {
+    problems.push("MAIL_DOMAIN: domain tidak valid");
+  }
+
+  const port = Number(env.PORT ?? 4000);
+  if (!Number.isInteger(port) || port < 0 || port > 65535) {
+    problems.push("PORT: tidak valid");
+  }
+
+  const configDir = (env.CONFIG_DIR ?? "/config").trim();
+  if (configDir.length === 0) problems.push("CONFIG_DIR: tidak boleh kosong");
+
+  if (problems.length > 0) {
+    throw new Error(`Konfigurasi tidak valid:\n  - ${problems.join("\n  - ")}`);
+  }
+
+  return { token, domain, configDir, port, host: env.HOST ?? "0.0.0.0" };
+}
diff --git a/agent/src/hash.ts b/agent/src/hash.ts
new file mode 100644
index 0000000..71556bf
--- /dev/null
+++ b/agent/src/hash.ts
@@ -0,0 +1,42 @@
+import { spawn } from "node:child_process";
+
+const SHA512_CRYPT = /^\$6\$[./0-9A-Za-z]{1,16}\$[./0-9A-Za-z]{86}$/;
+const TIMEOUT_MS = 5000;
+
+/**
+ * Membuat hash SHA512-CRYPT ($6$...) yang dipakai Dovecot, lewat `openssl passwd -6`.
+ * Password dikirim lewat stdin supaya tidak terlihat di daftar proses.
+ */
+export function hashPassword(
+  password: string,
+  opensslPath = "openssl",
+): Promise<string> {
+  return new Promise((resolve, reject) => {
+    const child = spawn(opensslPath, ["passwd", "-6", "-stdin"], {
+      stdio: ["pipe", "pipe", "ignore"],
+    });
+    let out = "";
+    const timer = setTimeout(() => {
+      child.kill("SIGKILL");
+      reject(new Error("openssl melebihi batas waktu"));
+    }, TIMEOUT_MS);
+
+    child.stdout.on("data", (chunk: Buffer) => {
+      out += chunk.toString("utf8");
+    });
+    child.on("error", (err) => {
+      clearTimeout(timer);
+      reject(err);
+    });
+    child.on("close", (code) => {
+      clearTimeout(timer);
+      const hash = out.trim();
+      if (code === 0 && SHA512_CRYPT.test(hash)) resolve(hash);
+      else reject(new Error("openssl gagal membuat hash"));
+    });
+    child.stdin.on("error", () => {
+      // Galat tulis ke stdin ditangani lewat event close/error proses.
+    });
+    child.stdin.end(`${password}\n`);
+  });
+}
diff --git a/agent/src/server.ts b/agent/src/server.ts
new file mode 100644
index 0000000..30a7d4c
--- /dev/null
+++ b/agent/src/server.ts
@@ -0,0 +1,38 @@
+import { createAgentApp } from "./app.ts";
+import { type AgentConfig, loadConfig } from "./config.ts";
+import { AccountStore } from "./store.ts";
+
+function main(): void {
+  let config: AgentConfig;
+  try {
+    config = loadConfig();
+  } catch (err) {
+    console.error((err as Error).message);
+    process.exit(1);
+  }
+
+  const server = createAgentApp(config, new AccountStore(config.configDir));
+  server.listen(config.port, config.host, () => {
+    console.log(
+      JSON.stringify({
+        msg: "account-agent berjalan",
+        port: config.port,
+        domain: config.domain,
+      }),
+    );
+  });
+
+  let closing = false;
+  const shutdown = (signal: string): void => {
+    if (closing) return;
+    closing = true;
+    console.log(JSON.stringify({ msg: "menutup layanan", signal }));
+    const force = setTimeout(() => process.exit(1), 5000);
+    force.unref();
+    server.close(() => process.exit(0));
+  };
+  process.on("SIGINT", () => shutdown("SIGINT"));
+  process.on("SIGTERM", () => shutdown("SIGTERM"));
+}
+
+main();
diff --git a/agent/src/store.ts b/agent/src/store.ts
new file mode 100644
index 0000000..6704964
--- /dev/null
+++ b/agent/src/store.ts
@@ -0,0 +1,208 @@
+import { randomBytes } from "node:crypto";
+import { copyFile, open, readFile, rename, rm, stat } from "node:fs/promises";
+import { join } from "node:path";
+import { hashPassword } from "./hash.ts";
+
+export class StoreError extends Error {
+  status: number;
+  code: string;
+
+  constructor(status: number, code: string, message: string) {
+    super(message);
+    this.name = "StoreError";
+    this.status = status;
+    this.code = code;
+  }
+}
+
+export interface AccountInfo {
+  email: string;
+  quota: string | null;
+}
+
+const ACCOUNTS_FILE = "postfix-accounts.cf";
+const QUOTAS_FILE = "dovecot-quotas.cf";
+
+function isNotFound(err: unknown): boolean {
+  return (
+    typeof err === "object" &&
+    err !== null &&
+    (err as { code?: string }).code === "ENOENT"
+  );
+}
+
+async function readText(path: string): Promise<string> {
+  try {
+    return await readFile(path, "utf8");
+  } catch (err) {
+    if (isNotFound(err)) return "";
+    throw err;
+  }
+}
+
+function toLines(text: string): string[] {
+  const lines = text.split("\n").map((l) => l.replace(/\r$/, ""));
+  while (lines.length > 0 && lines[lines.length - 1] === "") lines.pop();
+  return lines;
+}
+
+function fromLines(lines: string[]): string {
+  return lines.length === 0 ? "" : `${lines.join("\n")}\n`;
+}
+
+/** Email pada baris `email|{SCHEME}hash`; null untuk komentar atau baris asing. */
+function accountOf(line: string): string | null {
+  if (line.trimStart().startsWith("#")) return null;
+  const i = line.indexOf("|");
+  if (i < 1) return null;
+  return line.slice(0, i).trim().toLowerCase();
+}
+
+/** Email pada baris `email:kuota`; null untuk komentar atau baris asing. */
+function quotaOf(line: string): string | null {
+  if (line.trimStart().startsWith("#")) return null;
+  const i = line.lastIndexOf(":");
+  if (i < 1) return null;
+  return line.slice(0, i).trim().toLowerCase();
+}
+
+function quotaValue(line: string): string {
+  return line.slice(line.lastIndexOf(":") + 1).trim();
+}
+
+/**
+ * Menulis berkas secara atomik: tulis ke berkas sementara di folder yang sama,
+ * sync, lalu rename. Salinan versi sebelumnya disimpan sebagai `<nama>.bak`.
+ */
+async function writeAtomic(path: string, content: string): Promise<void> {
+  let mode = 0o644;
+  try {
+    mode = (await stat(path)).mode & 0o777;
+    await copyFile(path, `${path}.bak`);
+  } catch (err) {
+    if (!isNotFound(err)) throw err;
+  }
+
+  const tmp = `${path}.${randomBytes(6).toString("hex")}.tmp`;
+  try {
+    const handle = await open(tmp, "w", mode);
+    try {
+      await handle.writeFile(content, "utf8");
+      await handle.sync();
+    } finally {
+      await handle.close();
+    }
+    await rename(tmp, path);
+  } catch (err) {
+    await rm(tmp, { force: true });
+    throw err;
+  }
+}
+
+const notFound = () =>
+  new StoreError(404, "ACCOUNT_NOT_FOUND", "Akun tidak ditemukan");
+
+/**
+ * Pengelola akun berbasis berkas konfigurasi docker-mailserver. Perubahan dideteksi
+ * dan dimuat otomatis oleh docker-mailserver, tanpa akses ke Docker.
+ * Semua penulisan diserialkan dalam satu antrean.
+ */
+export class AccountStore {
+  #dir: string;
+  #queue: Promise<unknown> = Promise.resolve();
+
+  constructor(configDir: string) {
+    this.#dir = configDir;
+  }
+
+  #path(name: string): string {
+    return join(this.#dir, name);
+  }
+
+  #serial<T>(fn: () => Promise<T>): Promise<T> {
+    const next = this.#queue.then(fn);
+    this.#queue = next.catch(() => undefined);
+    return next;
+  }
+
+  async list(): Promise<AccountInfo[]> {
+    const [accounts, quotas] = await Promise.all([
+      readText(this.#path(ACCOUNTS_FILE)),
+      readText(this.#path(QUOTAS_FILE)),
+    ]);
+
+    const quotaByEmail = new Map<string, string>();
+    for (const line of toLines(quotas)) {
+      const email = quotaOf(line);
+      if (email) quotaByEmail.set(email, quotaValue(line));
+    }
+
+    const result: AccountInfo[] = [];
+    for (const line of toLines(accounts)) {
+      const email = accountOf(line);
+      if (email) result.push({ email, quota: quotaByEmail.get(email) ?? null });
+    }
+    return result.sort((a, b) => a.email.localeCompare(b.email));
+  }
+
+  async create(email: string, password: string): Promise<void> {
+    const hash = await hashPassword(password);
+    await this.#serial(async () => {
+      const path = this.#path(ACCOUNTS_FILE);
+      const lines = toLines(await readText(path));
+      if (lines.some((l) => accountOf(l) === email)) {
+        throw new StoreError(409, "ACCOUNT_EXISTS", "Akun sudah ada");
+      }
+      lines.push(`${email}|{SHA512-CRYPT}${hash}`);
+      await writeAtomic(path, fromLines(lines));
+    });
+  }
+
+  async setPassword(email: string, password: string): Promise<void> {
+    const hash = await hashPassword(password);
+    await this.#serial(async () => {
+      const path = this.#path(ACCOUNTS_FILE);
+      const lines = toLines(await readText(path));
+      let found = false;
+      const next = lines.map((line) => {
+        if (accountOf(line) !== email) return line;
+        found = true;
+        return `${email}|{SHA512-CRYPT}${hash}`;
+      });
+      if (!found) throw notFound();
+      await writeAtomic(path, fromLines(next));
+    });
+  }
+
+  /** Menghapus akun dan kuotanya. Isi mailbox di disk tidak disentuh. */
+  async remove(email: string): Promise<void> {
+    await this.#serial(async () => {
+      const accountsPath = this.#path(ACCOUNTS_FILE);
+      const lines = toLines(await readText(accountsPath));
+      const kept = lines.filter((l) => accountOf(l) !== email);
+      if (kept.length === lines.length) throw notFound();
+      await writeAtomic(accountsPath, fromLines(kept));
+
+      const quotasPath = this.#path(QUOTAS_FILE);
+      const quotaLines = toLines(await readText(quotasPath));
+      const quotaKept = quotaLines.filter((l) => quotaOf(l) !== email);
+      if (quotaKept.length !== quotaLines.length) {
+        await writeAtomic(quotasPath, fromLines(quotaKept));
+      }
+    });
+  }
+
+  /** Mengatur kuota (mis. "2G"), atau menghapusnya bila null. */
+  async setQuota(email: string, quota: string | null): Promise<void> {
+    await this.#serial(async () => {
+      const accounts = toLines(await readText(this.#path(ACCOUNTS_FILE)));
+      if (!accounts.some((l) => accountOf(l) === email)) throw notFound();
+
+      const quotasPath = this.#path(QUOTAS_FILE);
+      const lines = toLines(await readText(quotasPath));
+      const rest = lines.filter((l) => quotaOf(l) !== email);
+      if (quota !== null) rest.push(`${email}:${quota}`);
+      await writeAtomic(quotasPath, fromLines(rest));
+    });
+  }
+}
diff --git a/agent/src/validate.ts b/agent/src/validate.ts
new file mode 100644
index 0000000..5ab7e03
--- /dev/null
+++ b/agent/src/validate.ts
@@ -0,0 +1,41 @@
+const LOCAL_PART = /^[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$/;
+const QUOTA = /^[1-9]\d{0,5}[MG]$/;
+
+export const PASSWORD_MIN = 12;
+export const PASSWORD_MAX = 128;
+
+/** Email huruf kecil bila valid dan berada di domain yang diizinkan, selain itu null. */
+export function normalizeEmail(raw: unknown, domain: string): string | null {
+  if (typeof raw !== "string") return null;
+  const value = raw.trim().toLowerCase();
+  if (value.length > 254) return null;
+  const parts = value.split("@");
+  if (parts.length !== 2) return null;
+  const [local, host] = parts as [string, string];
+  if (host !== domain) return null;
+  if (!LOCAL_PART.test(local) || local.includes("..")) return null;
+  return `${local}@${host}`;
+}
+
+/** Pesan masalah bila password tidak memenuhi syarat, atau null bila boleh. */
+export function passwordProblem(raw: unknown): string | null {
+  if (typeof raw !== "string") return "password harus berupa teks";
+  if (raw.length < PASSWORD_MIN)
+    return `password minimal ${PASSWORD_MIN} karakter`;
+  if (raw.length > PASSWORD_MAX)
+    return `password maksimal ${PASSWORD_MAX} karakter`;
+  if (/[\r\n\0]/.test(raw)) {
+    return "password tidak boleh berisi baris baru atau karakter kosong";
+  }
+  return null;
+}
+
+export type QuotaInput = { ok: true; value: string | null } | { ok: false };
+
+/** null menghapus kuota; selain itu bentuk seperti 500M atau 2G. */
+export function parseQuota(raw: unknown): QuotaInput {
+  if (raw === null) return { ok: true, value: null };
+  if (typeof raw !== "string") return { ok: false };
+  const value = raw.trim().toUpperCase();
+  return QUOTA.test(value) ? { ok: true, value } : { ok: false };
+}
