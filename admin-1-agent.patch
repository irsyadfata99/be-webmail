+import assert from "node:assert/strict";
+import type { AddressInfo } from "node:net";
+import { mkdtemp, rm } from "node:fs/promises";
+import type { Server } from "node:http";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { after, before, test } from "node:test";
+import { createAgentApp } from "../src/app.ts";
+import { AccountStore } from "../src/store.ts";
+
+const TOKEN = "ab".repeat(32);
+let dir: string;
+let server: Server;
+let base: string;
+
+before(async () => {
+  dir = await mkdtemp(join(tmpdir(), "agent-http-"));
+  server = createAgentApp(
+    {
+      token: TOKEN,
+      domain: "example.com",
+      configDir: dir,
+      port: 0,
+      host: "127.0.0.1",
+    },
+    new AccountStore(dir),
+  );
+  await new Promise<void>((resolve) => server.listen(0, "127.0.0.1", resolve));
+  base = `http://127.0.0.1:${(server.address() as AddressInfo).port}`;
+});
+after(async () => {
+  await new Promise<void>((resolve) => server.close(() => resolve()));
+  await rm(dir, { recursive: true, force: true });
+});
+
+const auth = { Authorization: `Bearer ${TOKEN}` };
+const json = { ...auth, "Content-Type": "application/json" };
+
+async function call(
+  method: string,
+  path: string,
+  body?: unknown,
+  headers: Record<string, string> = json,
+) {
+  const res = await fetch(`${base}${path}`, {
+    method,
+    headers,
+    body: body === undefined ? undefined : JSON.stringify(body),
+  });
+  return {
+    status: res.status,
+    body: (await res.json()) as Record<string, any>,
+  };
+}
+
+test("/health terbuka tanpa token, rute lain menolak tanpa atau dengan token salah", async () => {
+  assert.equal((await call("GET", "/health", undefined, {})).status, 200);
+  assert.equal((await call("GET", "/accounts", undefined, {})).status, 401);
+  assert.equal(
+    (
+      await call("GET", "/accounts", undefined, {
+        Authorization: "Bearer salah",
+      })
+    ).status,
+    401,
+  );
+  assert.equal(
+    (await call("GET", "/accounts", undefined, { Authorization: TOKEN }))
+      .status,
+    401,
+  );
+  const wrong = { Authorization: `Bearer ${"cd".repeat(32)}` };
+  assert.equal((await call("GET", "/accounts", undefined, wrong)).status, 401);
+});
+
+test("alur akun lengkap lewat HTTP", async () => {
+  const created = await call("POST", "/accounts", {
+    email: "Siti@Example.com",
+    password: "Sandi Siti 123456",
+  });
+  assert.equal(created.status, 201);
+  assert.deepEqual(created.body, { email: "siti@example.com" });
+
+  const dup = await call("POST", "/accounts", {
+    email: "siti@example.com",
+    password: "Sandi Siti 123456",
+  });
+  assert.equal(dup.status, 409);
+  assert.equal(dup.body.error.code, "ACCOUNT_EXISTS");
+
+  const list = await call("GET", "/accounts");
+  assert.equal(list.status, 200);
+  assert.deepEqual(list.body.accounts, [
+    { email: "siti@example.com", quota: null },
+  ]);
+  assert.equal(JSON.stringify(list.body).includes("$6$"), false);
+
+  assert.equal(
+    (
+      await call("PUT", "/accounts/siti%40example.com/password", {
+        password: "Sandi Baru Siti 789",
+      })
+    ).status,
+    200,
+  );
+  const q = await call("PUT", "/accounts/siti%40example.com/quota", {
+    quota: "2g",
+  });
+  assert.deepEqual(q.body, { email: "siti@example.com", quota: "2G" });
+  assert.equal((await call("GET", "/accounts")).body.accounts[0].quota, "2G");
+  assert.equal(
+    (await call("PUT", "/accounts/siti%40example.com/quota", { quota: null }))
+      .body.quota,
+    null,
+  );
+
+  assert.equal(
+    (await call("DELETE", "/accounts/siti%40example.com")).status,
+    200,
+  );
+  assert.equal(
+    (await call("DELETE", "/accounts/siti%40example.com")).status,
+    404,
+  );
+  assert.deepEqual((await call("GET", "/accounts")).body.accounts, []);
+});
+
+test("input tidak valid ditolak dengan 400 dan pesan yang jelas", async () => {
+  const cases: Array<[string, string, unknown, string]> = [
+    [
+      "POST",
+      "/accounts",
+      { email: "x@lain.com", password: "Sandi Cukup Panjang" },
+      "INVALID_EMAIL",
+    ],
+    [
+      "POST",
+      "/accounts",
+      { email: "x@example.com", password: "pendek" },
+      "INVALID_PASSWORD",
+    ],
+    ["POST", "/accounts", { password: "Sandi Cukup Panjang" }, "INVALID_EMAIL"],
+    [
+      "PUT",
+      "/accounts/siti%40example.com/quota",
+      { quota: "99X" },
+      "INVALID_QUOTA",
+    ],
+    [
+      "PUT",
+      "/accounts/%E0%A4%A/password",
+      { password: "Sandi Cukup Panjang" },
+      "INVALID_EMAIL",
+    ],
+    [
+      "PUT",
+      "/accounts/..%2F..%2Fetc%2Fpasswd/password",
+      { password: "Sandi Cukup Panjang" },
+      "INVALID_EMAIL",
+    ],
+  ];
+  for (const [method, path, body, code] of cases) {
+    const res = await call(method, path, body);
+    assert.equal(res.status, 400, `${method} ${path}`);
+    assert.equal(res.body.error.code, code, `${method} ${path}`);
+  }
+});
+
+test("body terlalu besar 413, bukan JSON 415, JSON rusak 400", async () => {
+  const big = await call("POST", "/accounts", {
+    email: "a@example.com",
+    password: "x".repeat(20_000),
+  });
+  assert.equal(big.status, 413);
+  assert.equal(
+    (
+      await call(
+        "POST",
+        "/accounts",
+        { x: 1 },
+        { ...auth, "Content-Type": "text/plain" },
+      )
+    ).status,
+    415,
+  );
+  const broken = await fetch(`${base}/accounts`, {
+    method: "POST",
+    headers: json,
+    body: "{rusak",
+  });
+  assert.equal(broken.status, 400);
+});
+
+test("rute tidak dikenal 404 dan metode salah 405", async () => {
+  assert.equal((await call("GET", "/tidak-ada")).status, 404);
+  assert.equal((await call("DELETE", "/accounts")).status, 405);
+  assert.equal(
+    (await call("GET", "/accounts/siti%40example.com/password")).status,
+    405,
+  );
+  assert.equal(
+    (await call("POST", "/accounts/siti%40example.com", {})).status,
+    405,
+  );
+});
diff --git a/agent/test/store.check.ts b/agent/test/store.check.ts
new file mode 100644
index 0000000..6ef87c8
--- /dev/null
+++ b/agent/test/store.check.ts
@@ -0,0 +1,200 @@
+import assert from "node:assert/strict";
+import { execFileSync } from "node:child_process";
+import { mkdtemp, readdir, readFile, rm, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { after, before, test } from "node:test";
+import { AccountStore, StoreError } from "../src/store.ts";
+
+let dir: string;
+let store: AccountStore;
+
+before(async () => {
+  dir = await mkdtemp(join(tmpdir(), "agent-store-"));
+  store = new AccountStore(dir);
+});
+after(async () => {
+  await rm(dir, { recursive: true, force: true });
+});
+
+const accountsFile = () => join(dir, "postfix-accounts.cf");
+const read = (name: string) => readFile(join(dir, name), "utf8");
+
+/** Menghitung ulang hash dengan salt yang sama lewat openssl dan membandingkannya. */
+function passwordMatches(line: string, password: string): boolean {
+  const hash = line.split("|{SHA512-CRYPT}")[1] ?? "";
+  const salt = hash.split("$")[2] ?? "";
+  const again = execFileSync(
+    "openssl",
+    ["passwd", "-6", "-salt", salt, "-stdin"],
+    {
+      input: `${password}\n`,
+    },
+  )
+    .toString()
+    .trim();
+  return again === hash;
+}
+
+const lineOf = async (email: string) =>
+  (await read("postfix-accounts.cf"))
+    .split("\n")
+    .find((l) => l.startsWith(`${email}|`)) ?? "";
+
+test("create menulis baris SHA512-CRYPT yang cocok dengan password", async () => {
+  await store.create("budi@example.com", "Sandi Pertama 123!");
+  const line = await lineOf("budi@example.com");
+  assert.match(
+    line,
+    /^budi@example\.com\|\{SHA512-CRYPT\}\$6\$[./0-9A-Za-z]{1,16}\$[./0-9A-Za-z]{86}$/,
+  );
+  assert.equal(passwordMatches(line, "Sandi Pertama 123!"), true);
+  assert.equal(passwordMatches(line, "sandi salah 12345"), false);
+  assert.ok((await read("postfix-accounts.cf")).endsWith("\n"));
+});
+
+test("password dengan spasi, simbol, dan unicode tersimpan apa adanya", async () => {
+  const passwords = [
+    "  spasi di tepi  ",
+    "p@ss:word/dengan|simbol$&'\"`",
+    "kata sandi ✓ ünïcode 日本語",
+  ];
+  for (const [i, password] of passwords.entries()) {
+    const email = `unik${i}@example.com`;
+    await store.create(email, password);
+    assert.equal(passwordMatches(await lineOf(email), password), true, email);
+  }
+});
+
+test("create menolak akun ganda dengan 409", async () => {
+  await assert.rejects(
+    store.create("budi@example.com", "Sandi Kedua 12345"),
+    (e: unknown) =>
+      e instanceof StoreError &&
+      e.status === 409 &&
+      e.code === "ACCOUNT_EXISTS",
+  );
+});
+
+test("setPassword mengganti hash akun itu saja", async () => {
+  const before = await lineOf("unik0@example.com");
+  await store.setPassword("budi@example.com", "Sandi Baru 456789!");
+  const line = await lineOf("budi@example.com");
+  assert.equal(passwordMatches(line, "Sandi Baru 456789!"), true);
+  assert.equal(passwordMatches(line, "Sandi Pertama 123!"), false);
+  assert.equal(await lineOf("unik0@example.com"), before);
+});
+
+test("setPassword, setQuota, dan remove pada akun yang tidak ada memberi 404", async () => {
+  const notFound = (e: unknown) => e instanceof StoreError && e.status === 404;
+  await assert.rejects(
+    store.setPassword("hantu@example.com", "Sandi Apa Saja 1"),
+    notFound,
+  );
+  await assert.rejects(store.setQuota("hantu@example.com", "1G"), notFound);
+  await assert.rejects(store.remove("hantu@example.com"), notFound);
+});
+
+test("kuota: atur, tampil di list, ubah, dan hapus", async () => {
+  await store.setQuota("budi@example.com", "2G");
+  assert.equal(
+    (await store.list()).find((a) => a.email === "budi@example.com")?.quota,
+    "2G",
+  );
+  await store.setQuota("budi@example.com", "500M");
+  assert.equal(
+    (await read("dovecot-quotas.cf")).match(/budi@example\.com:/g)?.length,
+    1,
+  );
+  assert.equal(
+    (await store.list()).find((a) => a.email === "budi@example.com")?.quota,
+    "500M",
+  );
+  await store.setQuota("budi@example.com", null);
+  assert.equal(
+    (await store.list()).find((a) => a.email === "budi@example.com")?.quota,
+    null,
+  );
+});
+
+test("list tidak pernah memuat hash dan terurut", async () => {
+  const accounts = await store.list();
+  assert.ok(accounts.length >= 4);
+  assert.ok(JSON.stringify(accounts).indexOf("$6$") === -1);
+  const emails = accounts.map((a) => a.email);
+  assert.deepEqual(
+    emails,
+    [...emails].sort((a, b) => a.localeCompare(b)),
+  );
+});
+
+test("remove menghapus akun beserta kuotanya dan membiarkan akun lain", async () => {
+  await store.setQuota("unik1@example.com", "1G");
+  await store.remove("unik1@example.com");
+  assert.equal(
+    (await read("postfix-accounts.cf")).includes("unik1@example.com"),
+    false,
+  );
+  assert.equal(
+    (await read("dovecot-quotas.cf")).includes("unik1@example.com"),
+    false,
+  );
+  assert.ok((await read("postfix-accounts.cf")).includes("unik0@example.com"));
+});
+
+test("komentar dan baris asing dipertahankan, CRLF dirapikan", async () => {
+  const other = await mkdtemp(join(tmpdir(), "agent-keep-"));
+  try {
+    await writeFile(
+      join(other, "postfix-accounts.cf"),
+      "# akun lama\r\nlama@example.com|{SHA512-CRYPT}$6$abc$xyz\r\n\r\n# catatan\r\n",
+    );
+    await writeFile(
+      join(other, "dovecot-quotas.cf"),
+      "# kuota\nlama@example.com:3G\n",
+    );
+    const s = new AccountStore(other);
+    await s.create("baru@example.com", "Sandi Baru Banget 1");
+    await s.setQuota("baru@example.com", "1G");
+    const accounts = await readFile(join(other, "postfix-accounts.cf"), "utf8");
+    assert.ok(
+      accounts.startsWith(
+        "# akun lama\nlama@example.com|{SHA512-CRYPT}$6$abc$xyz\n",
+      ),
+    );
+    assert.ok(accounts.includes("# catatan"));
+    assert.ok(accounts.includes("baru@example.com|{SHA512-CRYPT}$6$"));
+    assert.equal(accounts.includes("\r"), false);
+    const quotas = await readFile(join(other, "dovecot-quotas.cf"), "utf8");
+    assert.ok(quotas.startsWith("# kuota\nlama@example.com:3G\n"));
+    assert.ok(quotas.includes("baru@example.com:1G"));
+  } finally {
+    await rm(other, { recursive: true, force: true });
+  }
+});
+
+test("15 pembuatan paralel semuanya tersimpan tanpa saling menimpa", async () => {
+  const other = await mkdtemp(join(tmpdir(), "agent-par-"));
+  try {
+    const s = new AccountStore(other);
+    await Promise.all(
+      Array.from({ length: 15 }, (_, i) =>
+        s.create(`par${i}@example.com`, `Sandi Paralel ${i} aman`),
+      ),
+    );
+    assert.equal((await s.list()).length, 15);
+  } finally {
+    await rm(other, { recursive: true, force: true });
+  }
+});
+
+test("salinan .bak dibuat dan tidak ada berkas .tmp tersisa", async () => {
+  const files = await readdir(dir);
+  assert.ok(files.includes("postfix-accounts.cf.bak"));
+  assert.deepEqual(
+    files.filter((f) => f.endsWith(".tmp")),
+    [],
+  );
+  assert.ok((await read("postfix-accounts.cf.bak")).length > 0);
+  assert.equal(accountsFile().endsWith("postfix-accounts.cf"), true);
+});
diff --git a/agent/test/validate.check.ts b/agent/test/validate.check.ts
new file mode 100644
index 0000000..cbe01bd
--- /dev/null
+++ b/agent/test/validate.check.ts
@@ -0,0 +1,97 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { loadConfig } from "../src/config.ts";
+import {
+  normalizeEmail,
+  parseQuota,
+  passwordProblem,
+} from "../src/validate.ts";
+
+const DOMAIN = "example.com";
+
+test("normalizeEmail menerima email valid dan menyeragamkan huruf kecil", () => {
+  assert.equal(
+    normalizeEmail("Budi.Santoso@Example.com ", DOMAIN),
+    "budi.santoso@example.com",
+  );
+  assert.equal(normalizeEmail("a@example.com", DOMAIN), "a@example.com");
+  assert.equal(
+    normalizeEmail("tim-1_x@example.com", DOMAIN),
+    "tim-1_x@example.com",
+  );
+});
+
+test("normalizeEmail menolak domain lain, bentuk aneh, dan non-teks", () => {
+  for (const bad of [
+    "budi@lain.com",
+    "budi@sub.example.com",
+    "@example.com",
+    "budi@",
+    "budi",
+    "a@b@example.com",
+    "bu di@example.com",
+    "budi+tag@example.com",
+    ".budi@example.com",
+    "budi.@example.com",
+    "bu..di@example.com",
+    "budi\n@example.com",
+    "budi|x@example.com",
+    "budi:x@example.com",
+    `${"a".repeat(65)}@example.com`,
+  ]) {
+    assert.equal(normalizeEmail(bad, DOMAIN), null, bad);
+  }
+  assert.equal(normalizeEmail(123, DOMAIN), null);
+  assert.equal(normalizeEmail(undefined, DOMAIN), null);
+});
+
+test("passwordProblem memeriksa panjang dan karakter terlarang", () => {
+  assert.equal(passwordProblem("p@ss: dengan spasi ✓ ok"), null);
+  assert.equal(passwordProblem("a".repeat(12)), null);
+  assert.match(passwordProblem("pendek") ?? "", /minimal 12/);
+  assert.match(passwordProblem("a".repeat(129)) ?? "", /maksimal 128/);
+  assert.match(passwordProblem(`${"a".repeat(12)}\nx`) ?? "", /baris baru/);
+  assert.match(passwordProblem(`${"a".repeat(12)}\0`) ?? "", /baris baru/);
+  assert.match(passwordProblem(42) ?? "", /teks/);
+});
+
+test("parseQuota menerima 500M dan 2G, null untuk hapus, dan menolak sisanya", () => {
+  assert.deepEqual(parseQuota("2g"), { ok: true, value: "2G" });
+  assert.deepEqual(parseQuota(" 500M "), { ok: true, value: "500M" });
+  assert.deepEqual(parseQuota(null), { ok: true, value: null });
+  for (const bad of [
+    "0G",
+    "2",
+    "2T",
+    "G",
+    "-1G",
+    "1.5G",
+    "2GB",
+    "",
+    5,
+    undefined,
+  ]) {
+    assert.deepEqual(parseQuota(bad), { ok: false }, String(bad));
+  }
+});
+
+test("loadConfig menolak token dan domain tidak valid tanpa menampilkan nilainya", () => {
+  assert.throws(
+    () =>
+      loadConfig({
+        AGENT_TOKEN: "rahasia-pendek",
+        MAIL_DOMAIN: "bukan domain",
+      }),
+    (err: Error) =>
+      /AGENT_TOKEN/.test(err.message) &&
+      /MAIL_DOMAIN/.test(err.message) &&
+      !err.message.includes("rahasia-pendek"),
+  );
+  const ok = loadConfig({
+    AGENT_TOKEN: "a".repeat(64),
+    MAIL_DOMAIN: "Example.COM",
+  });
+  assert.equal(ok.domain, "example.com");
+  assert.equal(ok.port, 4000);
+  assert.equal(ok.configDir, "/config");
+});
